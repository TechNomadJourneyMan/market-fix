# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Демо-аккаунты (работают без Supabase, через куку market-fix-demo-session):
#   guest@demo.kz / demo1234      → личный кабинет гостя
#   business@demo.kz / demo1234   → кабинет бизнеса

# Supabase (опционально — для облачной auth; демо-вход работает и без этих ключей)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Карта: OpenStreetMap (Leaflet). API-ключ НЕ требуется — карта работает из коробки.
# Переменные ниже нужны только если захотите подменить источник тайлов
# (например, на собственный сервер или платного провайдера).
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# NEXT_PUBLIC_MAP_TILE_URL_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Server-only
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_DB_PASSWORD=
